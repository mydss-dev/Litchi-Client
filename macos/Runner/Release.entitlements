<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A proxy client must spawn the sing-box subprocess and run
	     `networksetup` to change the system proxy; neither is possible under
	     the App Sandbox, so it is disabled (this app ships outside the MAS). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- flutter_secure_storage stores the login credentials in the Keychain;
	     without a keychain access group the app has none (ad-hoc builds carry
	     no application-identifier), so SecItem* calls fail with -34018. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.litchi.litchiClient</string>
	</array>
</dict>
</plist>
