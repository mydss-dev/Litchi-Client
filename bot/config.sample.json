{
  // ═══════════════════════════════════════════════════════════════════════════
  //  Litchi 客户端远程配置文件
  // ═══════════════════════════════════════════════════════════════════════════
  //
  //  说明：此 JSON 对象即签名后交付给客户端的配置 payload。
  //        填写完成后请将整段内容复制发送给 Bot，Bot 会自动：
  //          1. 剥离注释
  //          2. 校验字段格式
  //          3. Ed25519 签名
  //          4. 生成可托管的 signed config
  //
  //  必填字段：app_name、api_base_list、logo_url
  //  建议填写：invite_url_base、avatar_url
  //  不要填写：update_version、update_download_url、update_sha256
  //  安装包生成后，Bot 会自动填写并生成最终发布配置。
  // ═══════════════════════════════════════════════════════════════════════════

  // ── 应用名称（必填，1-40 字符）─────────────────────────────────────────────
  "app_name": "My VPN",

  // ── API 服务器地址列表（必填，至少一个 https:// URL）───────────────────────
  //  客户端按顺序尝试，首个可连通的地址会被持续使用。
  "api_base_list": [
    "https://api.example.com",
    "https://api2.example.com"
  ],

  // ── API 路径前缀（可选，以 / 开头，不超过 80 字符）─────────────────────────
  //  大多数面板填 "/api/v1"，留空表示无前缀。
  "api_prefix": "/api/v1",

  // ── Logo 图片 URL（必填，https://）─────────────────────────────────────────
  "logo_url": "https://example.com/logo.png",

  // ── 头像图片 URL（可选）────────────────────────────────────────────────────
  "avatar_url": "https://example.com/avatar.png",

  // ── 邀请链接基础 URL（建议填写，https://）──────────────────────────────────
  //  用于自动补全注册/邀请链接。
  "invite_url_base": "https://example.com",

  // ── 是否启用客户端更新 ─────────────────────────────────────────────────────
  //  默认 true。只有 /build 生成更高版本安装包后才提示更新。
  //  首次或版本变化时必须打包；同版本时 Bot 会询问只更新配置还是重新打包。
  //  同版本重打只影响新下载用户；已有用户的图标和原生名称要等下次版本更新后生效。
  //  false 时仍保存真实构建版本和安装包信息，但客户端不显示更新提示。
  "update_enabled": true,

  // ── 强制更新版本号（可选，如 "1.3.0"）───────────────────────────────────────
  //  客户端版本低于此值时提示强制更新。留空不启用。
  "update_version": "",

  // ── 各平台下载地址（可选）──────────────────────────────────────────────────
  //  支持两种格式：
  //    1. 单一 URL 字符串（所有平台共用）
  //    2. 按平台分别指定：{"windows":"...","macos":"...","android":"..."}
  //  留空 {} 不启用更新下载。
  "update_download_url": "",

  // ── 各平台安装包 SHA-256（启用更新时必填）─────────────────────────────────
  //  必须与 update_download_url 使用相同的平台键。
  "update_sha256": "",

  // ── 更新日志（可选，不超过 200 字符）───────────────────────────────────────
  "update_changelog": "修复已知问题，优化用户体验。"
}
