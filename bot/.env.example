# Telegram
BOT_TOKEN=123456:replace_me
# Required: comma-separated Telegram numeric administrator ids.
# The bot refuses to start when this is empty.
BOT_ADMINS=123456789,987654321

# GitHub workflow dispatch
GITHUB_TOKEN=ghp_replace_me
GITHUB_REPO=mydss-dev/Litchi-Client
GITHUB_REF=main
GITHUB_WORKFLOW_ID=white-label-build.yml
# Required build version sent to GitHub Actions.
BUILD_VERSION=1.2.7

# Public custom domain attached to the Cloudflare R2 bucket.
DOWNLOAD_BASE_URL=https://download.example.com

# Bot persistence
DB_PATH=./data/bot.sqlite
# Required: encrypts tenant Ed25519 private keys stored in SQLite.
# Generate once with: openssl rand -hex 32
KEY_ENCRYPTION_KEY=replace_with_64_hex_characters

# Each /build command counts once even when all three platforms are selected.
BUILD_RATE_LIMIT_MAX=2
BUILD_RATE_LIMIT_HOURS=24
