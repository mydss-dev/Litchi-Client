# Inno Setup local output
installer_output/
# OSS config (contains api_base, keep off git)
oss_config.json

# sing-box runtime cache (BoltDB) — leaks DNS/fakeip history, never commit
cache.db
*.pid
litchi_singbox.pid

# libbox core — built fresh per-build by ensureOfficialLibbox (multi-ABI on CI).
# Never commit a prebuilt .aar: a stale/partial-ABI copy short-circuits the
# build and silently ships a core that won't load on real (arm64) phones.
android/app/libs/libbox.aar
android/app/libs/libbox-legacy.aar

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
