# Inno Setup local output
installer_output/
# OSS config (contains api_base, keep off git)
oss_config.json
# Local working copy of the config template
bot/config.json

# mihomo runtime cache — may contain DNS/fake-IP history
cache.db
*.pid
mihomo.pid.json

# Embedded mihomo libraries are built from source for every Android release.
android/app/src/main/jniLibs/
android/app/src/main/cpp/includes/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/core/mihomo/litchi-mihomo*
/coverage/

# White-label images are generated from LOGO_URL before desktop/mobile builds.
/assets/images/*
!/assets/images/.gitkeep

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android/Flutter generated caches and local machine config
/android/.gradle/
/android/local.properties
/android/key.properties
/android/app/upload-keystore.jks
/android/app/*.jks
/android/signing-secrets.txt
/android/app/src/main/assets/*.mmdb
/android/app/src/main/assets/*.dat
/local_test_config.json
**/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/linux/flutter/ephemeral/

# Accidental nested project / build output
/litchi_client/

# Local remote-config payload (contains secret API prefix/domains) — never commit
payload.json
payload.js
config.js

# Local update manifest — upload to OSS, do not commit
version.json

# ── Bot ──────────────────────────────────────────────────────────────────
bot/.env
bot/data/
bot/node_modules/
bot/*.sqlite
bot/*.sqlite-shm
bot/*.sqlite-wal

# OSS hosting (aaPanel auto-generated)
bot/.htaccess
bot/.user.ini
bot/404.html
bot/502.html
bot/index.html
bot/.well-known/
